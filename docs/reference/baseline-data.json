  "animations": {
    "transitions": [
      "all",
      "0.15s",
      "transform 0.5s ease-in-out",
      "box-shadow 0.5s ease-in-out",
      "visibility linear, opacity 0.5s",
      "transform 0.2s"
    ],
    "animations": [
      "slide-strip-enter: 0.25s ease-out 1",
      "popover-enter: 0.3s ease-out 1"
    ],
    "keyframes": [
      {
        "name": "rotate",
        "cssText": "@keyframes rotate { \n  100% { transform: rotate(360deg); }\n}"
      },
      {
        "name": "dash",
        "cssText": "@keyframes dash { \n  0% { stroke-dasharray: 1, 300; stroke-dashoffset: 0; }\n  50% { stroke-dasharray: 150, 300; stroke-dashoffset: -200; }\n  100% { stroke-dasharray: 1, 300; stroke-dashoffset: -280; }"
      },
      {
        "name": "Modal__background__fade-in",
        "cssText": "@keyframes Modal__background__fade-in { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}"
      },
      {
        "name": "Modal__content_fade-in",
        "cssText": "@keyframes Modal__content_fade-in { \n  0% { opacity: 0; transform: scale(0.9); }\n  100% { opacity: 1; transform: scale(1); }\n}"
      },
      {
        "name": "library-unit__adder-animation",
        "cssText": "@keyframes library-unit__adder-animation { \n  0% { transform: scale(0.85); }\n  50% { transform: scale(1); }\n  100% { transform: scale(0.85); }\n}"
      },
      {
        "name": "library-unit__skeleton-opacity-animation",
        "cssText": "@keyframes library-unit__skeleton-opacity-animation { \n  0% { opacity: 0; }\n  75% { opacity: 0; }\n  100% { opacity: 0.5; }\n}"
      },
      {
        "name": "successStatusAnimation",
        "cssText": "@keyframes successStatusAnimation { \n  0% { transform: scale(0.35); }\n  50% { transform: scale(1.25); }\n  100% { transform: scale(1); }\n}"
      },
      {
        "name": "speaking-indicator-anim",
        "cssText": "@keyframes speaking-indicator-anim { \n  0%, 100% { transform: scaleY(1); }\n  50% { transform: scaleY(2); }\n}"
      },
      {
        "name": "warning-pulse",
        "cssText": "@keyframes warning-pulse { \n  0% { opacity: 1; }\n  100% { opacity: 0.6; }\n}"
      },
      {
        "name": "pulse",
        "cssText": "@keyframes pulse { \n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.5; transform: scale(0.9); }\n}"
      },
      {
        "name": "checkPop",
        "cssText": "@keyframes checkPop { \n  0% { transform: scale(0); }\n  100% { transform: scale(1); }\n}"
      },
      {
        "name": "fadeIn",
        "cssText": "@keyframes fadeIn { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}"
      },
      {
        "name": "slideUp",
        "cssText": "@keyframes slideUp { \n  0% { opacity: 0; transform: translateY(20px) scale(0.98); }\n  100% { opacity: 1; transform: translateY(0px) scale(1); }\n}"
      },
      {
        "name": "toast-slide-down",
        "cssText": "@keyframes toast-slide-down { \n  0% { opacity: 0; transform: translate(-50%) translateY(-20px); }\n  100% { opacity: 1; transform: translate(-50%) translateY(0px); }\n}"
      },
      {
        "name": "slide-strip-enter",
        "cssText": "@keyframes slide-strip-enter { \n  0% { opacity: 0; transform: translateY(-50%) translate(12px); }\n  100% { opacity: 1; transform: translateY(-50%) translate(0px); }\n}"
      },
      {
        "name": "popover-enter",
        "cssText": "@keyframes popover-enter { \n  0% { opacity: 0; transform: translateY(-50%) translate(8px); }\n  100% { opacity: 1; transform: translateY(-50%) translate(0px); }\n}"
      },
      {
        "name": "overlay-fade-in",
        "cssText": "@keyframes overlay-fade-in { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}"
      },
      {
        "name": "modal-scale-in",
        "cssText": "@keyframes modal-scale-in { \n  0% { opacity: 0; transform: scale(0.95) translateY(10px); }\n  100% { opacity: 1; transform: scale(1) translateY(0px); }\n}"
      },
      {
        "name": "fade-in",
        "cssText": "@keyframes fade-in { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}"
      },
      {
        "name": "spin",
        "cssText": "@keyframes spin { \n  100% { transform: rotate(360deg); }\n}"
      }
    ]
  },
